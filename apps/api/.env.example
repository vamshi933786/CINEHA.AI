# CINEHA AI Backend Configuration
PROJECT_NAME="CINEHA AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS configuration (comma-separated allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Relational Database (SQLAlchemy 2.0 Async URL)
# SQLite for local development:
DATABASE_URL="sqlite+aiosqlite:///./cineha_ai.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/cineha_prod"

# Video Processing Guardrails (100 MB Limit)
MAX_VIDEO_SIZE_MB=100

# AI Provider Settings
AI_PROVIDER="gemini" # Options: heuristic_mock, gemini, openai
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Caption Studio Speech-to-Text Providers
TRANSCRIPTION_PROVIDER="local_whisper" # Options: local_whisper (default, free offline), production (OpenAI API), mock
LOCAL_WHISPER_MODEL="base" # Options: tiny, base, small, medium, large-v3
WHISPER_API_KEY=""
WHISPER_MODEL="whisper-1"
ENABLE_HYBRID_SPEECH_RESTORATION=true

# Language Processor (Translation & Transliteration)
LANGUAGE_PROCESSOR_PROVIDER="mock" # Options: mock, production
LANGUAGE_PROCESSOR_API_KEY=""
LANGUAGE_PROCESSOR_MODEL="gpt-4o-mini"

# Script Studio AI Visual Concepts & Image Generation
IMAGE_PROVIDER="unconfigured" # Options: unconfigured, mock, openai, imagen
IMAGE_GENERATION_API_KEY=""
IMAGE_MODEL="dall-e-3"
IMAGE_STORAGE_DIR="storage/visuals"
